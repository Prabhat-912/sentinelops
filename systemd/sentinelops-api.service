[Unit]
Description=SentinelOps REST API
After=network.target sentinelops.service
Requires=sentinelops.service

[Service]
Type=simple
WorkingDirectory=/mnt/p/Linux_Prj/sentinelops
ExecStart=/mnt/p/Linux_Prj/sentinelops/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 app.api:app
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
